{
  "id": "code-readiness-fs",
  "scope": "repository root only",
  "levelThreshold": 0.8,
  "level1Threshold": 0.8,
  "minLevel": 1,
  "v1SkipLLM": true,
  "pillars": [
    {
      "id": "style-linting",
      "name": "Style & Linting"
    },
    {
      "id": "testing",
      "name": "Testing"
    },
    {
      "id": "documentation",
      "name": "Documentation"
    },
    {
      "id": "dev-environment",
      "name": "Developer Environment"
    },
    {
      "id": "ci-cd",
      "name": "CI/CD"
    },
    {
      "id": "code-health",
      "name": "Code Health"
    },
    {
      "id": "security",
      "name": "Security"
    }
  ],
  "criteria": [
    {
      "id": "editorconfig",
      "name": "EditorConfig present",
      "pillarId": "style-linting",
      "level": 2,
      "requiresLLM": false,
      "anyFiles": [".editorconfig"],
      "fail": "No .editorconfig found.",
      "fix": "Add an .editorconfig to standardize indentation and file encoding.",
      "effort": "low"
    },
    {
      "id": "linter",
      "name": "Linter configured",
      "pillarId": "style-linting",
      "level": 1,
      "requiresLLM": false,
      "anyFiles": [
        ".eslintrc",
        ".eslintrc.*",
        "eslint.config.*",
        "biome.json",
        "biome.jsonc",
        ".ruff.toml",
        "ruff.toml",
        ".oxlintrc.json",
        ".golangci.yml",
        ".golangci.yaml",
        ".golangci.toml",
        ".golangci.json",
        "detekt.yml",
        ".detekt.yml",
        "stylecop.json",
        ".rubocop.yml",
        "phpstan.neon",
        "phpstan.neon.dist",
        "psalm.xml",
        "phpcs.xml",
        ".swiftlint.yml",
        "checkstyle.xml",
        "pmd.xml",
        ".flake8",
        ".pylintrc",
        "pylintrc",
        "clippy.toml",
        ".clippy.toml",
        ".clang-tidy",
        ".hlint.yaml",
        "hlint.yaml",
        ".credo.exs",
        ".tflint.hcl",
        ".shellcheckrc",
        ".luacheckrc",
        ".jshintrc"
      ],
      "fileContains": [
        { "file": "build.gradle.kts", "includes": ["detekt", "ktlint", "checkstyle", "pmd", "spotbugs"] },
        { "file": "build.gradle", "includes": ["detekt", "ktlint", "checkstyle", "pmd", "spotbugs"] },
        { "file": "pom.xml", "includes": ["checkstyle", "maven-pmd-plugin", "spotbugs"] },
        { "file": "package.json", "includes": ["\"eslint\"", "eslintConfig", "\"biome\"", "\"oxlint\""] },
        { "file": "pyproject.toml", "includes": ["[tool.ruff", "[tool.ruff.lint]", "[tool.pylint", "[tool.flake8"] },
        { "file": "setup.cfg", "includes": ["[flake8]", "[pylint"] },
        { "file": "Cargo.toml", "includes": ["[lints.clippy"] }
      ],
      "fail": "No linter configuration found.",
      "fix": "Add a linter config such as ESLint, Biome, Ruff, or golangci-lint.",
      "effort": "medium"
    },
    {
      "id": "formatter",
      "name": "Formatter configured",
      "pillarId": "style-linting",
      "level": 2,
      "requiresLLM": false,
      "anyFiles": [
        ".prettierrc",
        ".prettierrc.*",
        "prettier.config.*",
        ".dprint.json",
        ".dprint.jsonc",
        "dprint.json",
        "rustfmt.toml",
        ".rustfmt.toml",
        ".rubocop.yml",
        ".clang-format",
        ".swift-format",
        ".swiftformat",
        ".scalafmt.conf"
      ],
      "fileContains": [
        { "file": "biome.json", "includes": ["formatter"] },
        { "file": "biome.jsonc", "includes": ["formatter"] },
        { "file": "pyproject.toml", "includes": ["[tool.black]", "[tool.ruff"] },
        { "file": "package.json", "includes": ["\"prettier\""] }
      ],
      "languagesPass": {
        "go": "Go has built-in formatting via gofmt.",
        "rust": "Rust formatting is built-in via cargo fmt.",
        "csharp": "C# formatting is built-in via dotnet format."
      },
      "fail": "No formatter configuration found.",
      "fix": "Add Prettier, Biome, dprint, Black, or Ruff format config.",
      "effort": "medium"
    },
    {
      "id": "type-checker",
      "name": "Type checker configured",
      "pillarId": "style-linting",
      "level": 1,
      "requiresLLM": false,
      "anyFiles": ["tsconfig.json", "mypy.ini", ".mypy.ini", "pyrightconfig.json"],
      "fileContains": [
        { "file": "setup.cfg", "includes": ["[mypy]"] },
        { "file": "pyproject.toml", "includes": ["[tool.mypy]", "[tool.pyright]"] }
      ],
      "tsconfigStrict": true,
      "languagesPass": {
        "go": "Go has a built-in static type system.",
        "kotlin": "Kotlin has a built-in static type system.",
        "java": "Java has a built-in static type system.",
        "rust": "Rust has a built-in static type system.",
        "csharp": "C# has a built-in static type system.",
        "swift": "Swift has a built-in static type system."
      },
      "fail": "No type checker configured.",
      "fix": "Add a root tsconfig.json, or add mypy or pyright.",
      "effort": "medium"
    },
    {
      "id": "pre-commit-hooks",
      "name": "Pre-commit hooks configured",
      "pillarId": "style-linting",
      "level": 2,
      "requiresLLM": false,
      "anyFiles": [
        ".husky",
        ".lefthook.yml",
        "lefthook.yml",
        "lefthook.toml",
        ".lefthook.yaml",
        ".lefthook.toml",
        "lefthook.yaml",
        ".pre-commit-config.yaml",
        ".lintstagedrc",
        ".lintstagedrc.*"
      ],
      "fileContains": [
        { "file": "package.json", "includes": ["\"lint-staged\"", "\"simple-git-hooks\""] }
      ],
      "fail": "No pre-commit hooks found.",
      "fix": "Add Husky, Lefthook, lint-staged, or pre-commit hooks.",
      "effort": "medium"
    },
    {
      "id": "naming-conventions",
      "name": "Naming conventions",
      "pillarId": "style-linting",
      "level": 5,
      "requiresLLM": true,
      "fail": "Skipped. v1 does not run L5 quality checks.",
      "fix": "Document naming conventions for files, functions, and variables.",
      "effort": "medium"
    },
    {
      "id": "test-framework",
      "name": "Test framework configured",
      "pillarId": "testing",
      "level": 2,
      "requiresLLM": false,
      "anyFiles": [
        "jest.config.*",
        "vitest.config.*",
        "pytest.ini",
        "conftest.py",
        "tests/conftest.py",
        "**/conftest.py",
        "phpunit.xml",
        "phpunit.xml.dist",
        ".rspec",
        "spec/spec_helper.rb"
      ],
      "anyGlobs": [
        "**/*_test.go",
        "tests/**/*.rs",
        "**/*_test.rs",
        "tests/**/*_test.c",
        "tests/**/*_test.cpp"
      ],
      "fileContains": [
        { "file": "pyproject.toml", "includes": ["[tool.pytest"] },
        {
          "file": "package.json",
          "includes": ["\"jest\"", "\"vitest\"", "\"mocha\"", "\"ava\"", "\"node --test\"", "node:test", "node --test"]
        },
        { "file": "build.gradle.kts", "includes": ["kotest", "junit", "jupiter", "testImplementation"] },
        { "file": "build.gradle", "includes": ["junit", "jupiter", "kotest", "testImplementation"] },
        { "file": "pom.xml", "includes": ["junit"] },
        { "file": "Cargo.toml", "includes": ["[[test]]"] },
        { "file": "**/CMakeLists.txt", "includes": ["enable_testing", "add_test", "ctest"] }
      ],
      "fail": "No test framework configuration found.",
      "fix": "Configure Jest, Vitest, pytest, or Go testing.",
      "effort": "medium"
    },
    {
      "id": "test-files-exist",
      "name": "Test files exist",
      "pillarId": "testing",
      "level": 1,
      "requiresLLM": false,
      "testFiles": true,
      "fail": "No test files found.",
      "fix": "Add test files using *.test.*, *.spec.*, test_*.py, or *_test.go.",
      "effort": "medium"
    },
    {
      "id": "test-script",
      "name": "Test script defined",
      "pillarId": "testing",
      "level": 2,
      "requiresLLM": false,
      "packageJsonPath": "scripts.test",
      "makefileTarget": "test",
      "anyFiles": [
        "gradlew",
        "build.gradle.kts",
        "build.gradle",
        "mvnw",
        "pom.xml",
        "Cargo.toml",
        "*.sln",
        "*.csproj",
        "Rakefile",
        "scripts/test",
        "scripts/test.sh",
        "scripts/test-*",
        "tox.ini",
        "tox.toml",
        "noxfile.py",
        "pytest.ini"
      ],
      "fileContains": [
        { "file": "pyproject.toml", "includes": ["[tool.pytest", "[tool.tox", "[tool.hatch.envs"] }
      ],
      "fileRegex": [
        { "file": "justfile", "pattern": "(^|\\n)test\\s*:" },
        { "file": "Justfile", "pattern": "(^|\\n)test\\s*:" },
        { "file": "Taskfile.yml", "pattern": "(^|\\n)\\s+test\\s*:" },
        { "file": "Taskfile.yaml", "pattern": "(^|\\n)\\s+test\\s*:" }
      ],
      "fail": "No test script or test target found.",
      "fix": "Add a test script in package.json or a test target in the Makefile.",
      "effort": "medium"
    },
    {
      "id": "coverage-config",
      "name": "Coverage configured",
      "pillarId": "testing",
      "level": 4,
      "requiresLLM": false,
      "anyFiles": [".coveragerc", ".nycrc", ".nycrc.*"],
      "fileContains": [
        { "file": "jest.config.js", "includes": ["coverage"] },
        { "file": "jest.config.ts", "includes": ["coverage"] },
        { "file": "jest.config.mjs", "includes": ["coverage"] },
        { "file": "vitest.config.ts", "includes": ["coverage"] },
        { "file": "vitest.config.js", "includes": ["coverage"] },
        { "file": "pyproject.toml", "includes": ["[tool.coverage", "cov"] },
        { "file": "package.json", "includes": ["\"coverage\""] }
      ],
      "fail": "No coverage configuration found.",
      "fix": "Configure coverage in the test runner or add .coveragerc / .nycrc.",
      "effort": "high"
    },
    {
      "id": "e2e-tests",
      "name": "E2E / integration tests",
      "pillarId": "testing",
      "level": 4,
      "requiresLLM": false,
      "anyFiles": ["playwright.config.*", "cypress.config.*", "cypress", "e2e", "tests/e2e", "integration"],
      "fail": "No E2E or integration test setup found.",
      "fix": "Add Playwright, Cypress, or an e2e directory.",
      "effort": "high"
    },
    {
      "id": "test-quality",
      "name": "Test quality",
      "pillarId": "testing",
      "level": 5,
      "requiresLLM": true,
      "fail": "Skipped. v1 does not run L5 quality checks.",
      "fix": "Improve test names, edge cases, and behavior coverage.",
      "effort": "high"
    },
    {
      "id": "readme",
      "name": "README with substance",
      "pillarId": "documentation",
      "level": 1,
      "requiresLLM": false,
      "anyFiles": ["README.md", "readme.md", "Readme.md"],
      "minBytes": 500,
      "fail": "No README.md with at least 500 characters.",
      "fix": "Add a README with project overview and setup.",
      "effort": "low"
    },
    {
      "id": "contributing",
      "name": "Contributing guide",
      "pillarId": "documentation",
      "level": 2,
      "requiresLLM": false,
      "anyFiles": [
        "CONTRIBUTING.md",
        "CONTRIBUTING.rst",
        "CONTRIBUTING",
        ".github/CONTRIBUTING.md",
        ".github/CONTRIBUTING.rst",
        "**/CONTRIBUTING.md",
        "docs/contributing*",
        "docs/**/contributing*"
      ],
      "fail": "No contributing guide found.",
      "fix": "Add CONTRIBUTING.md with workflow and PR guidelines.",
      "effort": "low"
    },
    {
      "id": "api-docs",
      "name": "API documentation",
      "pillarId": "documentation",
      "level": 3,
      "requiresLLM": false,
      "anyFiles": [
        "openapi.*",
        "swagger.*",
        "**/openapi.yaml",
        "**/openapi.yml",
        "**/swagger.yaml",
        "redocly.yaml",
        "docs/api*",
        "docs/api/**",
        "jsdoc.json",
        "typedoc.json"
      ],
      "fail": "No API documentation found.",
      "fix": "Add OpenAPI specs, TypeDoc, or docs/api.",
      "effort": "medium"
    },
    {
      "id": "codeowners",
      "name": "CODEOWNERS defined",
      "pillarId": "documentation",
      "level": 3,
      "requiresLLM": false,
      "anyFiles": ["CODEOWNERS", ".github/CODEOWNERS", "docs/CODEOWNERS"],
      "fail": "No CODEOWNERS file found.",
      "fix": "Add a CODEOWNERS file.",
      "effort": "low"
    },
    {
      "id": "ai-context",
      "name": "AI context files",
      "pillarId": "documentation",
      "level": 2,
      "requiresLLM": false,
      "anyFiles": [
        "CLAUDE.md",
        ".cursor/rules",
        ".cursorrules",
        ".github/copilot-instructions.md",
        "AGENTS.md",
        ".github/AGENTS.md",
        "GEMINI.md",
        ".github/instructions/**/*.md",
        ".windsurfrules",
        "WARP.md"
      ],
      "fail": "No AI context files found.",
      "fix": "Add AGENTS.md, CLAUDE.md, .cursor/rules, .cursorrules, or .github/copilot-instructions.md.",
      "effort": "low"
    },
    {
      "id": "architecture-docs",
      "name": "Architecture documentation",
      "pillarId": "documentation",
      "level": 4,
      "requiresLLM": false,
      "anyFiles": [
        "docs/architecture*",
        "docs/adr/*",
        "docs/adr/**",
        "docs/decisions/**",
        "adr/**",
        "ARCHITECTURE.md"
      ],
      "fail": "No architecture documentation found.",
      "fix": "Add ARCHITECTURE.md or docs/adr.",
      "effort": "high"
    },
    {
      "id": "readme-quality",
      "name": "README quality",
      "pillarId": "documentation",
      "level": 5,
      "requiresLLM": true,
      "fail": "Skipped. v1 does not run L5 quality checks.",
      "fix": "Improve README sections for install, usage, and contributing.",
      "effort": "high"
    },
    {
      "id": "docs-agent-friendliness",
      "name": "Documentation agent-friendliness",
      "pillarId": "documentation",
      "level": 5,
      "requiresLLM": true,
      "fail": "Skipped. v1 does not run L5 quality checks.",
      "fix": "Document structure, conventions, and how to test.",
      "effort": "high"
    },
    {
      "id": "lock-file",
      "name": "Lock file present",
      "pillarId": "dev-environment",
      "level": 2,
      "requiresLLM": false,
      "anyFiles": [
        "package-lock.json",
        "npm-shrinkwrap.json",
        "bun.lockb",
        "bun.lock",
        "yarn.lock",
        "pnpm-lock.yaml",
        "poetry.lock",
        "Pipfile.lock",
        "uv.lock",
        "pdm.lock",
        "go.sum",
        "Cargo.lock",
        "gradle.lockfile",
        "packages.lock.json",
        "Gemfile.lock",
        "composer.lock",
        "Package.resolved",
        "mix.lock",
        "flake.lock",
        "cabal.project.freeze",
        "pixi.lock"
      ],
      "fail": "No dependency lock file found.",
      "fix": "Commit a lock file for the package manager.",
      "effort": "low"
    },
    {
      "id": "env-documentation",
      "name": "Environment variables documented",
      "pillarId": "dev-environment",
      "level": 2,
      "requiresLLM": false,
      "anyFiles": [
        ".env.example",
        ".env.template",
        ".env.sample",
        "env.example",
        ".envrc.example",
        "dotenv.example"
      ],
      "fail": "No .env.example or similar found.",
      "fix": "Add .env.example documenting required variables.",
      "effort": "low"
    },
    {
      "id": "setup-script",
      "name": "Setup script or dev command",
      "pillarId": "dev-environment",
      "level": 2,
      "requiresLLM": false,
      "packageJsonPath": "scripts.dev|scripts.test|scripts.lint|scripts.build",
      "makefileTarget": "setup|install",
      "anyFiles": [
        "Makefile",
        "scripts/setup*",
        "gradlew",
        "mvnw",
        "*.sln",
        "Rakefile",
        "scripts/install",
        "scripts/install.sh",
        "scripts/install-*",
        "setup.py",
        "setup.cfg",
        "justfile",
        "Justfile",
        "Taskfile.yml",
        "Taskfile.yaml",
        "bootstrap.sh",
        "scripts/bootstrap*"
      ],
      "fileContains": [
        { "file": "pyproject.toml", "includes": ["[build-system]"] }
      ],
      "fail": "No setup script or dev command found.",
      "fix": "Add a Makefile setup target, scripts/setup, or a package.json test, lint, build, or dev script.",
      "effort": "medium"
    },
    {
      "id": "version-pinned",
      "name": "Runtime version pinned",
      "pillarId": "dev-environment",
      "level": 2,
      "requiresLLM": false,
      "anyFiles": [
        ".nvmrc",
        ".node-version",
        ".python-version",
        ".tool-versions",
        ".mise.toml",
        "go.mod",
        ".sdkmanrc",
        ".java-version",
        "rust-toolchain.toml",
        "rust-toolchain",
        ".ruby-version",
        ".php-version",
        ".swift-version",
        "global.json",
        ".go-version"
      ],
      "fileContains": [
        { "file": "pyproject.toml", "includes": ["requires-python"] },
        { "file": "setup.py", "includes": ["python_requires"] },
        { "file": "package.json", "includes": ["\"engines\"", "\"packageManager\""] },
        { "file": "Cargo.toml", "includes": ["rust-version"] },
        { "file": "runtime.txt", "includes": ["python-"] }
      ],
      "fail": "No runtime version pin found.",
      "fix": "Add .nvmrc, .python-version, .tool-versions, or go.mod.",
      "effort": "low"
    },
    {
      "id": "containerization",
      "name": "Containerization",
      "pillarId": "dev-environment",
      "level": 3,
      "requiresLLM": false,
      "anyFiles": [
        "Dockerfile",
        "docker-compose.yml",
        "docker-compose.yaml",
        "compose.yaml",
        "compose.yml",
        "Containerfile",
        ".devcontainer",
        "**/Dockerfile",
        "docker/Dockerfile",
        "deploy/Dockerfile",
        ".devcontainer/devcontainer.json"
      ],
      "fail": "No container configuration found.",
      "fix": "Add a Dockerfile, docker-compose, or .devcontainer.",
      "effort": "high"
    },
    {
      "id": "ci-config",
      "name": "CI configuration present",
      "pillarId": "ci-cd",
      "level": 2,
      "requiresLLM": false,
      "ciFiles": true,
      "fail": "No CI configuration found.",
      "fix": "Add GitHub Actions, GitLab CI, CircleCI, Azure Pipelines, Buildkite, Jenkins, or Travis config.",
      "effort": "medium"
    },
    {
      "id": "ci-runs-tests",
      "name": "CI runs tests",
      "pillarId": "ci-cd",
      "level": 3,
      "requiresLLM": false,
      "ciGrep": "\\b(npm\\s+test|yarn\\s+test|pnpm\\s+test|bun\\s+test|jest|vitest|pytest|go\\s+test|make\\s+test|npm\\s+run\\s+test|gradle\\s+test|gradlew\\s+test|mvn\\s+test|cargo\\s+test|dotnet\\s+test|phpunit|swift\\s+test)\\b",
      "fail": "CI configuration found but no test execution detected.",
      "fix": "Add a test step to CI. Do not run the test suite as part of this skill.",
      "effort": "medium"
    },
    {
      "id": "ci-runs-linters",
      "name": "CI runs linters",
      "pillarId": "ci-cd",
      "level": 3,
      "requiresLLM": false,
      "ciGrep": "\\b(npm\\s+run\\s+lint|yarn\\s+lint|pnpm\\s+lint|eslint|biome\\s+check|biome\\s+lint|ruff\\s+check|golangci-lint|make\\s+lint|cargo\\s+clippy|dotnet\\s+format|rubocop|phpstan|swiftlint)\\b",
      "fail": "CI configuration found but no linter execution detected.",
      "fix": "Add a lint step to CI. Do not run the linter as part of this skill.",
      "effort": "medium"
    },
    {
      "id": "build-automated",
      "name": "Build automated",
      "pillarId": "ci-cd",
      "level": 3,
      "requiresLLM": false,
      "packageJsonPath": "scripts.build",
      "makefileTarget": "build",
      "ciGrep": "\\b(npm\\s+run\\s+build|yarn\\s+build|pnpm\\s+build|make\\s+build|go\\s+build|cargo\\s+build|docker\\s+build|gradle\\s+build|mvn\\s+package|dotnet\\s+build|swift\\s+build)\\b",
      "fail": "No automated build process found.",
      "fix": "Add a build script or CI build step. Do not run the build as part of this skill.",
      "effort": "medium"
    },
    {
      "id": "deploy-pipeline",
      "name": "Deploy pipeline",
      "pillarId": "ci-cd",
      "level": 4,
      "requiresLLM": false,
      "anyFiles": [
        "vercel.json",
        "netlify.toml",
        "fly.toml",
        "railway.json",
        "render.yaml",
        "app.yaml",
        "serverless.yml",
        "serverless.yaml",
        "terraform",
        "pulumi"
      ],
      "ciGrep": "\\b(deploy|deployment|publish|release)\\b",
      "fail": "No deploy pipeline found.",
      "fix": "Add a deploy stage or platform config.",
      "effort": "high"
    },
    {
      "id": "branch-protection",
      "name": "Branch protection awareness",
      "pillarId": "ci-cd",
      "level": 4,
      "requiresLLM": false,
      "anyFiles": [".github/branch-protection*", ".github/settings.yml", ".github/settings.yaml"],
      "fileRegex": [
        { "file": "CONTRIBUTING.md", "pattern": "branch.?protection|protected.?branch|required review" }
      ],
      "fail": "No branch protection rules documented or configured.",
      "fix": "Document branch protection in CONTRIBUTING.md or .github/settings.yml.",
      "effort": "medium"
    },
    {
      "id": "no-outdated-deps",
      "name": "Dependencies recently updated",
      "pillarId": "code-health",
      "level": 3,
      "requiresLLM": false,
      "lockFileFreshDays": 180,
      "fail": "No lock file, or lock file mtime is older than 6 months.",
      "fix": "Commit a lock file and keep dependencies current. This check only reads mtime, it does not run npm or pip.",
      "effort": "medium"
    },
    {
      "id": "dead-code-detection",
      "name": "Dead code detection configured",
      "pillarId": "code-health",
      "level": 4,
      "requiresLLM": false,
      "anyFiles": ["knip.json", "knip.ts", "knip.config.ts", ".knip.json", ".deadcode*", ".vulture"],
      "fileContains": [
        { "file": "package.json", "includes": ["\"knip\"", "unused-exports", "ts-prune", "\"vulture\""] },
